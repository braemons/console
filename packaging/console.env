# Settings for braemons-console.service. Restart it after editing:
#
#     sudo systemctl restart braemons-console
#
# Where the console listens. Loopback by default: on a laptop it has no reason
# to be reachable (docs/PLAN.md §7). On a rig, which sits on the isolated rig
# network and is opened from a laptop, set 0.0.0.0 -- the Raspberry Pi image
# does.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=9000
